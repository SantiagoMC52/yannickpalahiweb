---
import Navbar from '../components/Navbar.astro';

interface Props {
	title?: string;
}

const { title = 'yannick palahi | art department' } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body
		class="min-h-screen bg-stone-50 text-zinc-900 antialiased selection:bg-zinc-900 selection:text-stone-100"
	>
		<Navbar />
		<main
			class="mx-auto w-full max-w-6xl px-5 pb-16 pt-10 sm:px-8 lg:px-10"
		>
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
